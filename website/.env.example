# Configure through native Sites environment-variable controls. Never commit secrets.
SITE_ORIGIN=https://your-site.chatgpt.site
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Active USD recurring prices: exactly $29/month or $108/year. No trial days.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Optional public release URLs. Empty means downloads are not published yet.
MAC_DOWNLOAD_URL=
WINDOWS_DOWNLOAD_URL=
LINUX_DOWNLOAD_URL=
DEMO_VIDEO_URL=
DEMO_POSTER_URL=
# Optional Google OIDC (keep ChatGPT sign-in available).
# Redirect URI: https://<SITE_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate >=32 random characters; rotating it signs Google users out.
SESSION_SECRET=

# Trusted Sites user IDs permitted to review community reports (empty = nobody).
COMMUNITY_MODERATOR_IDS=
