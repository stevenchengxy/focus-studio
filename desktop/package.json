{
  "name": "focus-studio-desktop",
  "version": "0.1.2",
  "description": "Installable screen recording and demo editing companion for Focus Studio",
  "desktopName": "focus-studio-desktop.desktop",
  "private": true,
  "main": "src/main.cjs",
  "author": "Focus Studio <support@focusstudio.app>",
  "homepage": "https://focus-studio.stevenchengxy19.chatgpt.site",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:electron": "electron test/electron-smoke.cjs",
    "dist:windows": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "pack:linux": "electron-builder --linux --x64 --dir --publish never",
    "checksums": "node scripts/checksums.cjs",
    "test:studio": "electron test/studio-free-smoke.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.focusstudio.desktop",
    "productName": "Focus Studio Desktop",
    "asar": true,
    "afterPack": "scripts/harden.cjs",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Focus-Studio-Desktop-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "syncDesktopName": true,
      "executableName": "focus-studio-desktop",
      "icon": "build/icon.png",
      "artifactName": "Focus-Studio-Desktop-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "focus-studio-desktop"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2",
        "libgbm1",
        "libsecret-1-0",
        "xdg-utils"
      ]
    },
    "publish": null
  }
}
